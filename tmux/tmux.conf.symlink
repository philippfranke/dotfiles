# tmux config file

#### Session Management ####
new-session -A -D -s main # Attach session if it exists

#### Terminal Configuration ####
set-option -ga terminal-overrides ",xterm-256color:Tc" # true colors
set -s escape-time 0 # Reduce escape time

#### Pane Configuration ####
# start with window 1 and pane 1
# split-screen
bind-key v split-window -h -c '#{pane_current_path}' # vertical split
bind-key s split-window -v -c '#{pane_current_path}' # horizontal split
set -g pane-border-style fg=colour238,bg=colour235
set -g pane-active-border-style fg=colour51,bg=colour236

# Pane navigation
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

#### Vim Mode Configuration ####
# Use Alt-arrow keys without prefix key to switch panes
is_vim="ps -o state= -o comm= -t '#{pane_tty}' \
    | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?g?(view|n?vim?x?)(diff)?$'"
bind-key -n C-h if-shell "$is_vim" "send-keys C-h"  "select-pane -L"
bind-key -n C-j if-shell "$is_vim" "send-keys C-j"  "select-pane -D"
bind-key -n C-k if-shell "$is_vim" "send-keys C-k"  "select-pane -U"
bind-key -n C-l if-shell "$is_vim" "send-keys C-l"  "select-pane -R"

# enable vi mode keys
set-window-option -g mode-keys vi
set -g status-keys vi

#### Copy and Paste Configuration ####
bind-key -T copy-mode-vi 'v' send -X begin-selection
# macOS clipboard integration. Modern macOS + tmux >=3 no longer need
# reattach-to-user-namespace; pbcopy/pbpaste work directly. Guarded with
# if-shell so these binds are simply skipped on hosts without pbcopy.
if-shell 'command -v pbcopy' {
    bind-key -T copy-mode-vi 'y' send -X copy-pipe-and-cancel "pbcopy"
    bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "pbcopy"
    unbind -T copy-mode-vi Enter
    bind-key -T copy-mode-vi Enter send-keys -X copy-pipe "pbcopy"
    bind ] run "pbpaste | tmux load-buffer - && tmux paste-buffer"
}

#### Pane Resizing Configuration ####
bind-key J resize-pane -D 5
bind-key K resize-pane -U 5
bind-key H resize-pane -L 5
bind-key L resize-pane -R 5

#### Mouse Configuration ####
set -g mouse off

#### Shell Configuration ####
# No default-command override: tmux inherits the (login) shell from its
# parent process (the terminal launches `zsh -l`), so reattach is unnecessary.

#### Statusbar Configuration ####
set -g status-style fg=colour137,bg=colour234,dim
set -g status-position bottom
set -g status-left '#[fg=colour233,bg=colour241,bold] #(whoami)@#H '
set -g status-right '#[fg=colour233,bg=colour241] #(~/.dotfiles/bin/battery.sh)%% #[fg=colour233,bg=colour243] %d/%m/%Y #[fg=colour233,bg=colour245] %H:%M:%S '
set -g status-right-length 80
set -g status-left-length 80
setw -g window-status-current-style fg=colour81,bg=colour238,bold
setw -g window-status-current-format ' #I#[fg=colour250]:#[fg=colour255]#W#[fg=colour50]#F '
setw -g window-status-style fg=colour138,bg=colour235,none
setw -g window-status-format ' #I#[fg=colour237]:#[fg=colour250]#W#[fg=colour244]#F '
setw -g window-status-bell-style fg=colour255,bg=colour1,bold

#### Modes Configuration ####
setw -g clock-mode-colour colour135
setw -g mode-style fg=colour196,bg=colour238,bold

#### Message Configuration ####
set -g message-style fg=colour232,bg=colour166,bold

#### Reload Configuration ####
unbind r
bind r source-file ~/.tmux.conf \; display "Reloaded!"
