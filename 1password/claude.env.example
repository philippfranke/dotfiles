# Template for the `claude` wrapper in 1password/op.zsh.
#
# Copy to ~/.config/op/claude.env and chmod 600 it. The copy is NOT tracked:
# it names your vaults and items, and this repo is public.
#
#   cp ~/.dotfiles/1password/claude.env.example ~/.config/op/claude.env
#   chmod 600 ~/.config/op/claude.env
#
# Each value is a 1Password secret reference — op://<vault>/<item>/[<section>/]<field>.
# `op run` swaps them for the real values when `claude` starts (biometric unlock
# via the desktop app). Plain KEY=value lines pass through unchanged. Uncomment
# only what you use: an env file with no live lines still triggers an unlock.

# Direct API billing instead of a claude.ai login:
#ANTHROPIC_API_KEY=op://<vault>/Anthropic/credential

# Tokens for tools and MCP servers Claude shells out to:
#GITHUB_TOKEN=op://<vault>/GitHub/token
