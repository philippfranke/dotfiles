# ~/.ssh/config — linked from 1password/ssh_config by script/bootstrap.
#
# Every host authenticates through the 1Password SSH agent, so no private keys
# need to live in ~/.ssh: keys are stored in 1Password and unlocked biometrically.
# Requires the "Use the SSH agent" toggle in 1Password → Settings → Developer.
# Host-specific entries (aliases, ports, users) can be added above the wildcard.
Host *
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
