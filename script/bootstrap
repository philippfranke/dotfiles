#!/usr/bin/env bash
#
# bootstrap — links this repo's *.symlink files (and a few hand-made links) into
# $HOME. Contains NO identity: per-machine identity lives ONLY in untracked
# $HOME override files (~/.gitconfig.identity, ~/.gitconfig.*.local,
# ~/.config/jj/config.toml). See README.md.
#
# Usage:
#   script/bootstrap            # link everything (prompts on conflicts)
#   DRY_RUN=1 script/bootstrap  # print what WOULD be linked, change nothing

cd "$(dirname "$0")/.."
DOTFILES_ROOT=$(pwd)

set -e

echo ''

info () {
  printf "  [ \033[00;34m..\033[0m ] %s\n" "$1"
}

user () {
  printf "\r  [ \033[0;33m?\033[0m ] %s " "$1"
}

success () {
  printf "\r\033[2K  [ \033[00;32mOK\033[0m ] %s\n" "$1"
}

fail () {
  printf "\r\033[2K  [\033[0;31mFAIL\033[0m] %s\n" "$1"
  echo ''
  exit 1
}

link_file () {
  local src=$1 dst=$2

  if [ "${DRY_RUN:-}" = "1" ]; then
    success "would link $src -> $dst"
    return
  fi

  local overwrite= backup= skip=
  local action=

  if [ -f "$dst" -o -d "$dst" -o -L "$dst" ]
  then
    if [ "$overwrite_all" == "false" ] && [ "$backup_all" == "false" ] && [ "$skip_all" == "false" ]
    then
      local currentSrc="$(readlink "$dst")"

      if [ "$currentSrc" == "$src" ]
      then
        skip=true;
      else
        user "File already exists: $dst ($(basename "$src")), what do you want to do?\n\
        [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
        read -n 1 action

        case "$action" in
          o ) overwrite=true;;
          O ) overwrite_all=true;;
          b ) backup=true;;
          B ) backup_all=true;;
          s ) skip=true;;
          S ) skip_all=true;;
          * ) ;;
        esac
      fi
    fi

    overwrite=${overwrite:-$overwrite_all}
    backup=${backup:-$backup_all}
    skip=${skip:-$skip_all}

    if [ "$overwrite" == "true" ]
    then
      rm -rf "$dst"
      success "removed $dst"
    fi

    if [ "$backup" == "true" ]
    then
      mv "$dst" "${dst}.backup"
      success "moved $dst to ${dst}.backup"
    fi

    if [ "$skip" == "true" ]
    then
      success "skipped $src"
    fi
  fi

  if [ "$skip" != "true" ]  # "false" or empty
  then
    mkdir -p "$(dirname "$dst")"
    ln -s "$src" "$dst"
    success "linked $src to $dst"
  fi
}

install_dotfiles () {
  info 'installing dotfiles'

  local overwrite_all=false backup_all=false skip_all=false

  # Convention: any *.symlink at depth <=2 -> ~/.<basename-without-.symlink>
  # (e.g. alacritty/alacritty.toml.symlink -> ~/.alacritty.toml).
  for src in $(find "$DOTFILES_ROOT" -maxdepth 2 -name '*.symlink')
  do
    dst="$HOME/.$(basename "${src%.*}")"
    link_file "$src" "$dst"
  done

  # Hand-made links that don't follow the *.symlink convention (nested targets):
  link_file "$DOTFILES_ROOT/vim/nvim.init.vim"    "$HOME/.config/nvim/init.vim"
  link_file "$DOTFILES_ROOT/gnupg/gpg-agent.conf" "$HOME/.gnupg/gpg-agent.conf"
  link_file "$DOTFILES_ROOT/claude/settings.json" "$HOME/.claude/settings.json"
  link_file "$DOTFILES_ROOT/gh/config.yml"       "$HOME/.config/gh/config.yml"
  link_file "$DOTFILES_ROOT/ghostty/config"      "$HOME/.config/ghostty/config"
  link_file "$DOTFILES_ROOT/1password/ssh_config" "$HOME/.ssh/config"
}

install_dotfiles

# Point THIS repo's hooks at the tracked .githooks dir (pre-commit secret scan).
# Repo-local on purpose: a global core.hooksPath would silence every other
# repo's own hooks.
install_hooks () {
  info 'enabling tracked git hooks for this repo'
  if [ "${DRY_RUN:-}" = "1" ]; then
    success "would run: git config core.hooksPath .githooks"
  elif [ "$(git -C "$DOTFILES_ROOT" config --local --get core.hooksPath 2>/dev/null)" = ".githooks" ]; then
    success 'core.hooksPath already .githooks'
  else
    git -C "$DOTFILES_ROOT" config core.hooksPath .githooks
    success 'core.hooksPath = .githooks'
  fi
  command -v gitleaks >/dev/null 2>&1 || info 'gitleaks not installed — brew install gitleaks for the credential scan'
}

install_hooks

echo ''
echo '  All linked! (Identity files in $HOME are NOT managed here — see README.md.)'
